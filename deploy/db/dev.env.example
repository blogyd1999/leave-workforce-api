# Copy to deploy/db/dev.env (gitignored) and replace every CHANGE_ME.
# Use simple values (letters, digits, - and _): the file is read by the shell and by Compose.
POSTGRES_DB=leave_workforce
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
MIGRATOR_PASSWORD=CHANGE_ME
APP_RW_PASSWORD=CHANGE_ME
RETENTION_JOB_PASSWORD=CHANGE_ME
